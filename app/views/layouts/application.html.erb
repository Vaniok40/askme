<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8"/>
  <title>InterestHub</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= stylesheet_pack_tag 'application', media: 'all' %>
  <%= javascript_pack_tag 'application' %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body>
<header class="header">
  <div class="header-inner">

    <a href="<%= root_path %>" class="header-brand">
      <i class="fa fa-compass"></i>
      <span class="header-brand-name">InterestHub</span>
    </a>

    <nav class="header-nav">
      <% if current_user %>
        <% if admin_user? %>
          <span class="header-admin-badge"><i class="fa fa-shield"></i> Admin</span>
        <% end %>

        <div class="header-nav-divider"></div>

        <%= link_to feed_path, class: 'header-nav-link' do %>
          <i class="fa fa-home"></i>
          <span>Fluxul meu</span>
        <% end %>

        <%= link_to discover_path, class: 'header-nav-link' do %>
          <i class="fa fa-compass"></i>
          <span>Descoperă</span>
        <% end %>

        <%= link_to my_posts_posts_path, class: 'header-nav-link' do %>
          <i class="fa fa-newspaper-o"></i>
          <span>Postările mele</span>
        <% end %>

        <%= link_to liked_posts_posts_path, class: 'header-nav-link' do %>
          <i class="fa fa-heart-o"></i>
          <span>Apreciate</span>
        <% end %>

        <div class="header-nav-divider"></div>

        <div class="header-nav-icons">
          <button class="header-nav-icon" id="msgPanelToggle" title="Mesaje">
            <i class="fa fa-envelope"></i>
            <span class="msg-badge" id="msgBadge" style="display:none"></span>
          </button>
          <button class="header-nav-icon" id="notifToggle" title="Notificări">
            <i class="fa fa-bell"></i>
            <span class="msg-badge" id="notifBadge" style="display:none"></span>
          </button>
        </div>

        <%= link_to user_path(current_user), class: 'header-user-pill' do %>
          <span class="header-user-avatar" style="background: <%= avatar_color(current_user) %>">
            <%= current_user.name[0].upcase %>
          </span>
          <span class="header-user-name">@<%= current_user.username %></span>
        <% end %>

        <%= link_to log_out_path, class: 'header-nav-link header-nav-link--muted' do %>
          <i class="fa fa-sign-out"></i>
        <% end %>

      <% else %>
        <%= link_to sign_up_path, class: 'header-auth-btn header-auth-btn--outline' do %>
          <i class="fa fa-user-plus"></i> Înregistrare
        <% end %>
        <%= link_to log_in_path, class: 'header-auth-btn header-auth-btn--solid' do %>
          <i class="fa fa-sign-in"></i> Autentificare
        <% end %>
      <% end %>
    </nav>

  </div>
</header>

<div class="content">
  <div class="container">
    <% if flash.any? %>
      <div id="flashData" style="display:none"
           data-flash="<%= html_escape(flash.map { |k,v| { type: k, message: v } }.to_json) %>"></div>
    <% end %>
    <div id="toastContainer"></div>
    <%= yield %>
  </div>
</div>

<% if current_user %>
  <%# ── Panel NOTIFICĂRI ── %>
  <div class="notif-panel" id="notifPanel">
    <div class="notif-panel-header">
      <span><i class="fa fa-bell"></i> Notificări</span>
      <div style="display:flex;align-items:center;gap:8px">
        <button class="notif-mark-all-btn" id="notifMarkAll">Marchează toate</button>
        <button class="msg-panel-close" id="notifPanelClose"><i class="fa fa-times"></i></button>
      </div>
    </div>
    <div class="notif-list" id="notifList">
      <div class="msg-list-loading"><i class="fa fa-spinner fa-spin"></i></div>
    </div>
  </div>

  <%# ── Side panel STÂNGA — lista conversații ── %>
  <div class="msg-panel" id="msgPanel">
    <div class="msg-panel-header">
      <span><i class="fa fa-comments"></i> Mesaje</span>
      <button class="msg-panel-close" id="msgPanelClose"><i class="fa fa-times"></i></button>
    </div>
    <div class="msg-panel-search">
      <input type="text" id="msgSearch" placeholder="Caută conversație…" class="msg-search-input">
    </div>
    <div class="msg-panel-list" id="msgList">
      <div class="msg-list-loading"><i class="fa fa-spinner fa-spin"></i></div>
    </div>
  </div>

  <%# ── Fereastra CHAT dreapta ── %>
  <div class="chat-window" id="chatWindow">
    <div class="chat-window-header" id="chatHeader">
      <div class="chat-header-user" id="chatHeaderUser"></div>
      <button class="chat-window-close" id="chatWindowClose"><i class="fa fa-times"></i></button>
    </div>
    <div class="chat-messages" id="chatMessages">
      <div class="chat-loading"><i class="fa fa-spinner fa-spin"></i></div>
    </div>
    <div class="chat-img-preview" id="chatImgPreview" style="display:none">
      <img id="chatImgThumb" src="" alt="">
      <button class="chat-img-preview-remove" id="chatImgRemove"><i class="fa fa-times"></i></button>
    </div>
    <div class="chat-input-area">
      <label class="chat-img-btn" title="Trimite imagine">
        <i class="fa fa-image"></i>
        <input type="file" id="chatImageInput" accept="image/*" style="display:none">
      </label>
      <textarea id="chatInput" class="chat-input" placeholder="Scrie un mesaj…" rows="1"></textarea>
      <button class="chat-send-btn" id="chatSendBtn"><i class="fa fa-paper-plane"></i></button>
    </div>
  </div>

  <%# ── Modal forward postare ── %>
  <div class="forward-modal-overlay" id="forwardOverlay" style="display:none">
    <div class="forward-modal" id="forwardModal">
      <div class="forward-modal-header">
        <span><i class="fa fa-share"></i> Trimite postarea</span>
        <button class="msg-panel-close" id="forwardModalClose"><i class="fa fa-times"></i></button>
      </div>
      <div class="forward-modal-body">
        <input type="text" id="forwardSearch" class="msg-search-input" placeholder="Caută conversație…">
        <div class="forward-convo-list" id="forwardConvoList">
          <div class="msg-list-loading"><i class="fa fa-spinner fa-spin"></i></div>
        </div>
      </div>
    </div>
  </div>

  <div class="msg-overlay" id="msgOverlay"></div>

  <script>
    window.CURRENT_USER_ID = <%= current_user.id %>;
    window.CSRF_TOKEN = '<%= form_authenticity_token %>';
  </script>
<% end %>

</body>
</html>
