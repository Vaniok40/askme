<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8"/>
  <title>ASK.me</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= javascript_pack_tag 'application' %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body>
<div class="header">
  <div class="container">
    <div class="header-logo">
      <h1 class="header-title">
        <%= link_to root_path do %>
          <i class="fa fa-comments"></i> ASK.me
        <% end %>
      </h1>
    </div>
    <div class="header-nav">
      <% if current_user %>
        <% if admin_user? %>
          <span class="header-admin-badge"><i class="fa fa-shield"></i> Admin</span>
        <% end %>
        <a href="#" class="header-nav-icon" title="Mesaje"><i class="fa fa-envelope"></i></a>
        <a href="#" class="header-nav-icon" title="Notificări"><i class="fa fa-bell"></i></a>
        <%= link_to my_posts_posts_path do %>
          <i class="fa fa-newspaper-o"></i> Postările mele
        <% end %>
        <%= link_to user_path(current_user) do %>
          <i class="fa fa-user"></i> @<%= current_user.username %>
        <% end %>
        <%= link_to log_out_path do %>
          <i class="fa fa-sign-out"></i> Deconectare
        <% end %>
      <% else %>
        <%= link_to sign_up_path, class: 'button button-light button-small' do %>
          <i class="fa fa-user-plus"></i> Înregistrare
        <% end %>
        <%= link_to log_in_path, class: 'button button-light button-small' do %>
          <i class="fa fa-sign-in"></i> Autentificare
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="content">
  <div class="container">
    <% if flash.any? %>
      <div class="buffer-both">
        <% flash.each do |name, message| %>
          <%= content_tag :div, message, class: "flash-#{name}" %>
        <% end %>
      </div>
    <% end %>
    <%= yield %>
  </div>
</div>
</body>
</html>
