<div class="auth-page">
  <div class="auth-card auth-card-wide">
    <div class="auth-card-header">
      <i class="fa fa-user-plus auth-icon"></i>
      <h1 class="auth-title">Alătură-te comunității!</h1>
      <p class="auth-subtitle">Creează-ți contul gratuit</p>
    </div>

    <div class="auth-card-body">
      <%= form_for @user do |f| %>
        <% if @user.errors.any? %>
          <div class="auth-errors">
            <i class="fa fa-exclamation-circle"></i>
            <ul>
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="auth-fields-grid">
          <div class="auth-field">
            <%= f.label :email, 'Email', class: 'auth-label' %>
            <div class="auth-input-wrap">
              <i class="fa fa-envelope auth-input-icon"></i>
              <%= f.text_field :email, class: 'auth-input', placeholder: 'adresa@exemplu.com' %>
            </div>
          </div>

          <div class="auth-field">
            <%= f.label :username, 'Nume de utilizator', class: 'auth-label' %>
            <div class="auth-input-wrap">
              <i class="fa fa-at auth-input-icon"></i>
              <%= f.text_field :username, class: 'auth-input', placeholder: 'username123' %>
            </div>
          </div>

          <div class="auth-field">
            <%= f.label :name, 'Nume complet', class: 'auth-label' %>
            <div class="auth-input-wrap">
              <i class="fa fa-user auth-input-icon"></i>
              <%= f.text_field :name, class: 'auth-input', placeholder: 'Ion Popescu' %>
            </div>
          </div>

          <div class="auth-field">
            <%= f.label :password, 'Parolă', class: 'auth-label' %>
            <div class="auth-input-wrap">
              <i class="fa fa-lock auth-input-icon"></i>
              <%= f.password_field :password, class: 'auth-input', placeholder: '••••••••' %>
            </div>
          </div>

          <div class="auth-field">
            <%= f.label :password_confirmation, 'Confirmă parola', class: 'auth-label' %>
            <div class="auth-input-wrap">
              <i class="fa fa-lock auth-input-icon"></i>
              <%= f.password_field :password_confirmation, class: 'auth-input', placeholder: '••••••••' %>
            </div>
          </div>
        </div>

        <div class="auth-actions">
          <%= f.submit 'Înregistrare', class: 'auth-btn' %>
        </div>
      <% end %>
    </div>

    <div class="auth-card-footer">
      Ai deja cont?
      <%= link_to 'Autentifică-te', log_in_path, class: 'auth-link' %>
    </div>
  </div>
</div>
