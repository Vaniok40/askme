<div class="fcard-page">
  <div class="fcard">
    <div class="fcard-header">
      <i class="fa fa-pencil fcard-icon"></i>
      <h1 class="fcard-title">Editează profilul</h1>
    </div>

    <div class="fcard-body">
      <%= form_for(@user) do |f| %>
        <% if @user.errors.any? %>
          <div class="fcard-errors">
            <i class="fa fa-exclamation-circle"></i>
            <ul>
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="fcard-field">
          <%= f.label :username, 'Nume de utilizator', class: 'fcard-label' %>
          <div class="fcard-input-wrap">
            <i class="fa fa-at fcard-input-icon"></i>
            <%= f.text_field :username, class: 'fcard-input' %>
          </div>
        </div>

        <div class="fcard-field">
          <%= f.label :name, 'Nume complet', class: 'fcard-label' %>
          <div class="fcard-input-wrap">
            <i class="fa fa-user fcard-input-icon"></i>
            <%= f.text_field :name, class: 'fcard-input' %>
          </div>
        </div>

        <div class="fcard-field">
          <%= f.label :password, 'Parolă nouă', class: 'fcard-label' %>
          <div class="fcard-input-wrap">
            <i class="fa fa-lock fcard-input-icon"></i>
            <%= f.password_field :password, class: 'fcard-input', placeholder: 'Lasă gol dacă nu schimbi' %>
          </div>
        </div>

        <div class="fcard-field">
          <%= f.label :password_confirmation, 'Confirmă parola', class: 'fcard-label' %>
          <div class="fcard-input-wrap">
            <i class="fa fa-lock fcard-input-icon"></i>
            <%= f.password_field :password_confirmation, class: 'fcard-input', placeholder: '••••••••' %>
          </div>
        </div>

        <% if admin_user? %>
          <div class="fcard-field fcard-checkbox-field">
            <label class="fcard-checkbox-label">
              <%= f.check_box :admin, class: 'fcard-checkbox' %>
              <span>Administrator</span>
            </label>
          </div>
        <% end %>

        <div class="fcard-actions">
          <%= f.submit 'Salvează modificările', class: 'fcard-btn', data: { confirm: 'Ești sigur?' } %>
        </div>

        <div class="fcard-danger-zone">
          <%= link_to user_path(@user), method: :delete,
                      class: 'fcard-danger-link',
                      data: { confirm: 'Ești sigur? Această acțiune este ireversibilă.' } do %>
            <i class="fa fa-trash"></i> Șterge contul @<%= current_user.username %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
