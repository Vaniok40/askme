<div class="profile-hero" style="background-color: <%= @user.color %>">
  <div class="profile-hero-inner">

    <% if admin_user? && current_user != @user %>
      <div class="profile-admin-actions">
        <% if @user.disabled? %>
          <%= button_to enable_user_path(@user), method: :patch, class: 'profile-admin-btn success', title: 'Enable account' do %>
            <i class="fa fa-check-circle"></i>
          <% end %>
        <% else %>
          <%= button_to disable_user_path(@user), method: :patch, class: 'profile-admin-btn warning', title: 'Disable account',
              data: { confirm: "Disable #{@user.username}?" } do %>
            <i class="fa fa-ban"></i>
          <% end %>
        <% end %>
        <%= button_to user_path(@user), method: :delete, class: 'profile-admin-btn danger', title: 'Delete account',
            data: { confirm: "Permanently delete #{@user.username}? This cannot be undone." } do %>
          <i class="fa fa-trash"></i>
        <% end %>
      </div>
    <% end %>

    <div class="profile-avatar-wrap">
      <div class="profile-avatar">
        <%= display_avatar(@user) %>
      </div>
      <% if @user.disabled? %>
        <span class="profile-disabled-badge"><i class="fa fa-ban"></i> Disabled</span>
      <% end %>
    </div>

    <h1 class="profile-name"><%= @user.name %></h1>
    <div class="profile-username">
      @<%= @user.username %>
      <% if @user.admin? %>
        <span class="user-admin-badge"><i class="fa fa-shield"></i> Admin</span>
      <% end %>
    </div>
    <div class="profile-joined"><i class="fa fa-calendar"></i> Member since <%= @user.created_at.strftime('%B %Y') %></div>

    <div class="profile-stats">
      <div class="profile-stat">
        <span class="profile-stat-value"><%= @posts_count %></span>
        <span class="profile-stat-label">Posts</span>
      </div>
      <div class="profile-stat">
        <span class="profile-stat-value"><%= @questions_count %></span>
        <span class="profile-stat-label">Questions</span>
      </div>
      <div class="profile-stat">
        <span class="profile-stat-value"><%= @answers_count %></span>
        <span class="profile-stat-label">Answers</span>
      </div>
      <div class="profile-stat">
        <span class="profile-stat-value"><%= @likes_received %></span>
        <span class="profile-stat-label">Likes</span>
      </div>
    </div>

    <div class="profile-hero-actions">
      <% if current_user == @user || admin_user? %>
        <%= link_to edit_user_path(@user), class: 'btn btn-light-outline' do %>
          <i class="fa fa-pencil"></i> Edit profile
        <% end %>
      <% end %>
      <% if current_user && current_user != @user %>
        <%= link_to '', class: 'btn btn-light-outline', id: 'ask-button' do %>
          <i class="fa fa-question-circle"></i> Ask me
        <% end %>
      <% end %>
    </div>

  </div>
</div>

<div class="profile-body">

  <div class="profile-sidebar">

    <% if current_user == @user || admin_user? %>
      <div class="profile-card">
        <h3 class="profile-card-title"><i class="fa fa-info-circle"></i> Account Info</h3>
        <dl class="profile-info-list">
          <dt>Email</dt>
          <dd><%= @user.email %></dd>
          <dt>Username</dt>
          <dd>@<%= @user.username %></dd>
          <dt>Display name</dt>
          <dd><%= @user.name %></dd>
          <dt>Profile color</dt>
          <dd>
            <span class="profile-color-swatch" style="background:<%= @user.color %>"></span>
            <%= @user.color %>
          </dd>
          <dt>Role</dt>
          <dd><%= @user.admin? ? 'Administrator' : 'User' %></dd>
          <dt>Status</dt>
          <dd><%= @user.disabled? ? 'Disabled' : 'Active' %></dd>
        </dl>
      </div>
    <% end %>

    <% if @interests.any? %>
      <div class="profile-card">
        <h3 class="profile-card-title"><i class="fa fa-tag"></i> Interests</h3>
        <div class="profile-interests">
          <% @interests.each do |tag| %>
            <%= link_to "##{tag.name}", tag_path(tag), class: 'post-tag' %>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>

  <div class="profile-main">

    <% if @posts.any? %>
      <section class="profile-section">
        <h2 class="profile-section-title"><i class="fa fa-newspaper-o"></i> Recent Posts</h2>
        <div class="feed-posts">
          <% @posts.each do |post| %>
            <%= render 'posts/post_card', post: post %>
          <% end %>
        </div>
        <% if @posts_count > 5 %>
          <%= link_to feed_path, class: 'profile-see-all' do %>
            See all posts <i class="fa fa-arrow-right"></i>
          <% end %>
        <% end %>
      </section>
    <% end %>

    <section class="profile-section">
      <h2 class="profile-section-title"><i class="fa fa-question-circle"></i> Questions</h2>

      <div class="user-question-form-div column-1-4 column-1-4-right" id="ask-form">
        <div class="user-question-form">
          <div class="form">
            <%= form_for @new_question do |f| %>
              <%= f.hidden_field :user_id %>
              <div class="form-field">
                <%= f.label "Your question @#{@user.username}", class: 'form-label' %>
                <%= f.text_area :text, class: 'form-textarea' %>
              </div>
              <div class="form-action">
                <%= submit_tag 'Ask', class: 'button button-small button-dark' %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <% if @questions.empty? %>
        <p class="profile-empty">No questions yet.</p>
      <% else %>
        <div class="questions-list">
          <% @questions.each do |question| %>
            <%= render partial: 'questions/question', object: question %>
          <% end %>
        </div>
      <% end %>
    </section>

  </div>

</div>

<!-- side panel for feed posts -->
<div class="side-panel" id="sidePanel">
  <button class="side-panel-close" id="sidePanelClose" title="Close"><i class="fa fa-times"></i></button>
  <div class="side-panel-content" id="sidePanelContent">
    <div class="side-panel-loading"><i class="fa fa-spinner fa-spin"></i></div>
  </div>
</div>
<div class="side-panel-overlay" id="sidePanelOverlay"></div>
