<div class="profile-hero" style="background-color: <%= avatar_color(@user) %>">
  <div class="profile-hero-inner">

    <% if admin_user? && current_user != @user %>
      <div class="profile-admin-actions">
        <% if @user.disabled? %>
          <%= button_to enable_user_path(@user), method: :patch, class: 'profile-admin-btn success', title: 'Activează contul' do %>
            <i class="fa fa-check-circle"></i>
          <% end %>
        <% else %>
          <%= button_to disable_user_path(@user), method: :patch, class: 'profile-admin-btn warning', title: 'Dezactivează contul',
              data: { confirm: "Dezactivezi #{@user.username}?" } do %>
            <i class="fa fa-ban"></i>
          <% end %>
        <% end %>
        <%= button_to user_path(@user), method: :delete, class: 'profile-admin-btn danger', title: 'Șterge contul',
            data: { confirm: "Ștergi permanent #{@user.username}? Aceasta nu poate fi anulată." } do %>
          <i class="fa fa-trash"></i>
        <% end %>
      </div>
    <% end %>

    <div class="profile-avatar-wrap">
      <div class="profile-avatar">
        <%= display_avatar(@user) %>
      </div>
      <% if @user.disabled? %>
        <span class="profile-disabled-badge"><i class="fa fa-ban"></i> Dezactivat</span>
      <% end %>
    </div>

    <h1 class="profile-name"><%= @user.name %></h1>
    <div class="profile-username">
      @<%= @user.username %>
      <% if @user.admin? %>
        <span class="user-admin-badge"><i class="fa fa-shield"></i> Admin</span>
      <% end %>
    </div>
    <div class="profile-joined"><i class="fa fa-calendar"></i> Membru din <%= ro_month_year(@user.created_at) %></div>

    <div class="profile-stats">
      <div class="profile-stat">
        <span class="profile-stat-value"><%= @posts_count %></span>
        <span class="profile-stat-label">Postări</span>
      </div>
      <div class="profile-stat">
        <span class="profile-stat-value"><%= @likes_received %></span>
        <span class="profile-stat-label">Aprecieri</span>
      </div>
    </div>

    <div class="profile-hero-actions">
      <% if current_user == @user || admin_user? %>
        <%= link_to edit_user_path(@user), class: 'btn btn-light-outline' do %>
          <i class="fa fa-pencil"></i> Editează profilul
        <% end %>
      <% end %>
      <% if current_user && current_user != @user %>
        <button class="btn btn-light-outline"
                id="startChatBtn"
                data-recipient-id="<%= @user.id %>"
                data-recipient-name="<%= @user.name %>"
                data-recipient-username="<%= @user.username %>"
                data-recipient-color="<%= avatar_color(@user) %>">
          <i class="fa fa-comment"></i> Trimite mesaj
        </button>
      <% end %>
    </div>

  </div>
</div>

<div class="profile-body">

  <div class="profile-sidebar">

    <% if current_user == @user || admin_user? %>
      <div class="profile-card profile-info-card">
        <h3 class="profile-card-title"><i class="fa fa-info-circle"></i> Informații cont</h3>
        <div class="profile-info-rows">
          <div class="profile-info-row">
            <span class="profile-info-icon"><i class="fa fa-envelope"></i></span>
            <div class="profile-info-content">
              <span class="profile-info-label">Email</span>
              <span class="profile-info-value"><%= @user.email %></span>
            </div>
          </div>
          <div class="profile-info-row">
            <span class="profile-info-icon"><i class="fa fa-at"></i></span>
            <div class="profile-info-content">
              <span class="profile-info-label">Utilizator</span>
              <span class="profile-info-value">@<%= @user.username %></span>
            </div>
          </div>
          <div class="profile-info-row">
            <span class="profile-info-icon"><i class="fa fa-user"></i></span>
            <div class="profile-info-content">
              <span class="profile-info-label">Nume afișat</span>
              <span class="profile-info-value"><%= @user.name %></span>
            </div>
          </div>
          <div class="profile-info-row">
            <span class="profile-info-icon"><i class="fa fa-shield"></i></span>
            <div class="profile-info-content">
              <span class="profile-info-label">Rol</span>
              <span class="profile-info-value">
                <% if @user.admin? %>
                  <span class="profile-role-badge admin"><i class="fa fa-shield"></i> Administrator</span>
                <% else %>
                  <span class="profile-role-badge user"><i class="fa fa-user"></i> Utilizator</span>
                <% end %>
              </span>
            </div>
          </div>
          <div class="profile-info-row">
            <span class="profile-info-icon"><i class="fa fa-circle"></i></span>
            <div class="profile-info-content">
              <span class="profile-info-label">Status</span>
              <span class="profile-info-value">
                <% if @user.disabled? %>
                  <span class="profile-status-badge disabled"><i class="fa fa-ban"></i> Dezactivat</span>
                <% else %>
                  <span class="profile-status-badge active"><i class="fa fa-check"></i> Activ</span>
                <% end %>
              </span>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% if @interests.any? %>
      <div class="profile-card">
        <h3 class="profile-card-title"><i class="fa fa-tag"></i> Interese</h3>
        <div class="profile-interests">
          <% @interests.each do |tag| %>
            <%= link_to "##{tag.name}", tag_path(tag), class: 'post-tag' %>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>

  <div class="profile-main">

    <% if @posts.any? %>
      <section class="profile-section">
        <h2 class="profile-section-title"><i class="fa fa-newspaper-o"></i> Postări recente</h2>
        <div class="feed-posts">
          <% @posts.each do |post| %>
            <%= render 'posts/post_card', post: post %>
          <% end %>
        </div>
        <% if @posts_count > 5 %>
          <%= link_to feed_path, class: 'profile-see-all' do %>
            Vezi toate postările <i class="fa fa-arrow-right"></i>
          <% end %>
        <% end %>
      </section>
    <% end %>

  </div>

</div>

<!-- side panel for feed posts -->
<div class="side-panel" id="sidePanel">
  <button class="side-panel-close" id="sidePanelClose" title="Închide"><i class="fa fa-times"></i></button>
  <div class="side-panel-content" id="sidePanelContent">
    <div class="side-panel-loading"><i class="fa fa-spinner fa-spin"></i></div>
  </div>
</div>
<div class="side-panel-overlay" id="sidePanelOverlay"></div>
