<div class="neural-page">

  <div class="neural-tag-bar">
    <div class="neural-tag-bar-inner">

      <form class="post-search-form" id="postSearchForm" action="<%= discover_path %>" method="get" role="search">
        <% @active_tag_ids.each do |tid| %>
          <input type="hidden" name="tag_ids[]" value="<%= tid %>">
        <% end %>
        <div class="post-search-wrap">
          <i class="fa fa-search post-search-icon"></i>
          <input type="text" name="q" id="postSearchInput" class="post-search-input"
                 placeholder="Caută în postări…"
                 value="<%= @query %>" autocomplete="off">
          <% if @query.present? %>
            <button type="button" class="post-search-clear" id="postSearchClear" title="Șterge căutarea">
              <i class="fa fa-times"></i>
            </button>
          <% end %>
        </div>
      </form>

      <div class="tag-search-wrap" id="feedTagSearch">
        <div class="tag-search-input-wrap">
          <i class="fa fa-tag tag-search-icon"></i>
          <input type="text" id="tagSearchInput" class="tag-search-input" placeholder="Filtrează etichetă…" autocomplete="off">
        </div>
        <ul class="tag-suggestions" id="tagSuggestions"></ul>
      </div>

      <div class="feed-active-tags" id="feedActiveTags">
        <% @active_tag_ids.each do |tid| %>
          <% tag = @all_tags.find { |t| t.id == tid } %>
          <% next unless tag %>
          <span class="feed-active-tag" data-id="<%= tag.id %>">
            <span class="feed-active-tag-name">#<%= tag.name %></span>
            <button class="feed-active-tag-remove">&times;</button>
          </span>
        <% end %>
      </div>

      <% if @active_tag_ids.any? || @query.present? %>
        <a href="<%= discover_path %>" class="feed-clear-filter-btn">
          <i class="fa fa-times-circle"></i> Resetează
        </a>
      <% end %>

      <div class="neural-tag-bar-actions">
        <% if @offset > 0 %>
          <%= link_to discover_path(tag_ids: @active_tag_ids, q: @query.presence, offset: [(@offset - 30), 0].max.nonzero?),
                      class: 'btn btn-secondary btn-sm' do %>
            <i class="fa fa-chevron-left"></i> Anterioare
          <% end %>
        <% end %>
        <% if @has_more %>
          <%= link_to discover_path(tag_ids: @active_tag_ids, q: @query.presence, offset: @offset + 30),
                      class: 'btn btn-secondary btn-sm' do %>
            Următoarele <i class="fa fa-chevron-right"></i>
          <% end %>
        <% end %>
        <% if current_user %>
          <%= link_to new_post_path, class: 'btn btn-primary btn-sm' do %>
            <i class="fa fa-pencil"></i> Postare nouă
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="neural-feed-wrap">
    <% if @posts.empty? %>
      <div class="feed-empty">
        <i class="fa fa-newspaper-o"></i>
        <p>Nicio postare găsită.</p>
      </div>
    <% else %>
      <div class="neural-canvas" id="neuralCanvas">
        <svg class="neural-svg" id="neuralSvg" aria-hidden="true"></svg>

        <% @posts.each_with_index do |post, i| %>
          <div class="neural-node"
               data-post-id="<%= post.id %>"
               data-index="<%= i %>"
               style="--node-color: <%= avatar_color(post.user) %>">
            <div class="neural-node-inner">
              <div class="neural-node-avatar" style="background: <%= avatar_color(post.user) %>;">
                <%= post.user.name[0].upcase %>
              </div>
            </div>
            <div class="neural-tooltip">
              <div class="neural-tooltip-title"><%= truncate(post.title, length: 60) %></div>
              <div class="neural-tooltip-body"><%= truncate(post.body, length: 100) %></div>
              <div class="neural-tooltip-meta">
                <span><i class="fa fa-heart-o"></i> <%= post.likes.size %></span>
                <span><i class="fa fa-comment-o"></i> <%= post.comments.size %></span>
                <% if post.tags.any? %>
                  <span class="neural-tooltip-tags"><%= post.tags.map { |t| "##{t.name}" }.first(3).join(' ') %></span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

</div>

<div class="side-panel" id="sidePanel">
  <button class="side-panel-close" id="sidePanelClose" title="Închide">
    <i class="fa fa-times"></i>
  </button>
  <div class="side-panel-content" id="sidePanelContent">
    <div class="side-panel-loading"><i class="fa fa-spinner fa-spin"></i></div>
  </div>
</div>
<div class="side-panel-overlay" id="sidePanelOverlay"></div>
