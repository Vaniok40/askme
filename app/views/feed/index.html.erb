<div class="feed-layout">

  <aside class="feed-interests">
    <h3 class="feed-interests-title"><i class="fa fa-tag"></i> Filtrează după etichete</h3>

    <div class="tag-search-wrap" id="feedTagSearch">
      <div class="tag-search-input-wrap">
        <i class="fa fa-search tag-search-icon"></i>
        <input type="text" id="tagSearchInput" class="tag-search-input" placeholder="Caută etichetă…" autocomplete="off">
      </div>
      <ul class="tag-suggestions" id="tagSuggestions"></ul>
    </div>

    <div class="feed-active-tags" id="feedActiveTags">
      <% @active_tag_ids.each do |tid| %>
        <% tag = @all_tags.find { |t| t.id == tid } %>
        <% next unless tag %>
        <span class="feed-active-tag" data-id="<%= tag.id %>">#<%= tag.name %> <button class="feed-active-tag-remove">×</button></span>
      <% end %>
    </div>

    <% if @active_tag_ids.any? %>
      <a href="<%= feed_path %>" class="feed-clear-filter"><i class="fa fa-times-circle"></i> Șterge filtrele</a>
    <% end %>

    <% if current_user %>
      <div class="feed-interests-divider"></div>
      <h3 class="feed-interests-title" style="margin-top:0"><i class="fa fa-heart"></i> Interesele mele</h3>
      <p class="feed-interests-hint">Urmărește subiecte pentru a personaliza fluxul tău.</p>
      <ul class="feed-tag-list">
        <% @all_tags.each do |tag| %>
          <% followed = current_user.interests.exists?(tag: tag) %>
          <li class="feed-tag-item<%= ' followed' if followed %>">
            <span class="feed-tag-name">#<%= tag.name %></span>
            <% if followed %>
              <%= button_to unfollow_tag_path(tag.id), method: :delete, class: 'btn-follow active', title: 'Nu mai urmări' do %>
                <i class="fa fa-check"></i>
              <% end %>
            <% else %>
              <%= button_to follow_tag_path(tag.id), method: :post, class: 'btn-follow', title: 'Urmărește' do %>
                <i class="fa fa-plus"></i>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </aside>

  <main class="feed-main">
    <div class="feed-header">
      <h2 class="feed-title">
        <% if current_user&.interests&.any? %>
          <i class="fa fa-star"></i> Fluxul tău
        <% else %>
          <i class="fa fa-globe"></i> Descoperă
        <% end %>
      </h2>
      <% if current_user %>
        <%= link_to new_post_path, class: 'btn btn-primary' do %>
          <i class="fa fa-pencil"></i> Postare nouă
        <% end %>
      <% end %>
    </div>

    <% if @posts.empty? %>
      <div class="feed-empty">
        <i class="fa fa-newspaper-o"></i>
        <p>Nicio postare încă. Fii primul care împărtășește ceva!</p>
      </div>
    <% else %>
      <div class="feed-posts" id="feedPosts">
        <% @posts.each do |post| %>
          <%= render 'posts/post_card', post: post %>
        <% end %>
      </div>
    <% end %>
  </main>

</div>

<!-- Sliding side panel -->
<div class="side-panel" id="sidePanel">
  <button class="side-panel-close" id="sidePanelClose" title="Închide">
    <i class="fa fa-times"></i>
  </button>
  <div class="side-panel-content" id="sidePanelContent">
    <div class="side-panel-loading"><i class="fa fa-spinner fa-spin"></i></div>
  </div>
</div>
<div class="side-panel-overlay" id="sidePanelOverlay"></div>
