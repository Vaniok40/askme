<div class="feed-layout">

  <aside class="feed-interests">
    <h3 class="feed-interests-title"><i class="fa fa-tag"></i> Interests</h3>
    <% if current_user %>
      <p class="feed-interests-hint">Follow topics to personalise your feed.</p>
    <% end %>
    <ul class="feed-tag-list">
      <% @all_tags.each do |tag| %>
        <% followed = current_user&.interests&.exists?(tag: tag) %>
        <li class="feed-tag-item<%= ' followed' if followed %>">
          <%= link_to "##{tag.name}", tag_path(tag), class: 'feed-tag-name' %>
          <% if current_user %>
            <% if followed %>
              <%= button_to unfollow_tag_path(tag.id), method: :delete, class: 'btn-follow active', title: 'Unfollow' do %>
                <i class="fa fa-check"></i>
              <% end %>
            <% else %>
              <%= button_to follow_tag_path(tag.id), method: :post, class: 'btn-follow', title: 'Follow' do %>
                <i class="fa fa-plus"></i>
              <% end %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </aside>

  <main class="feed-main">
    <div class="feed-header">
      <h2 class="feed-title">
        <% if current_user&.interests&.any? %>
          <i class="fa fa-star"></i> Your Feed
        <% else %>
          <i class="fa fa-globe"></i> Discover
        <% end %>
      </h2>
      <% if current_user %>
        <%= link_to new_post_path, class: 'btn btn-primary' do %>
          <i class="fa fa-pencil"></i> New Post
        <% end %>
      <% end %>
    </div>

    <% if @posts.empty? %>
      <div class="feed-empty">
        <i class="fa fa-newspaper-o"></i>
        <p>No posts yet. Be the first to share something!</p>
      </div>
    <% else %>
      <div class="feed-posts" id="feedPosts">
        <% @posts.each do |post| %>
          <%= render 'posts/post_card', post: post %>
        <% end %>
      </div>
    <% end %>
  </main>

</div>

<!-- Sliding side panel -->
<div class="side-panel" id="sidePanel">
  <button class="side-panel-close" id="sidePanelClose" title="Close">
    <i class="fa fa-times"></i>
  </button>
  <div class="side-panel-content" id="sidePanelContent">
    <div class="side-panel-loading"><i class="fa fa-spinner fa-spin"></i></div>
  </div>
</div>
<div class="side-panel-overlay" id="sidePanelOverlay"></div>
