<div class="fcard-page">
  <div class="fcard fcard-wide">
    <div class="fcard-header">
      <i class="fa fa-pencil fcard-icon"></i>
      <h1 class="fcard-title">Editează postarea</h1>
    </div>

    <div class="fcard-body">
      <%= form_with model: @post, url: post_path(@post), method: :patch, local: true, multipart: true do |f| %>
        <% if @post.errors.any? %>
          <div class="fcard-errors">
            <i class="fa fa-exclamation-circle"></i>
            <ul>
              <% @post.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="fcard-field">
          <%= f.label :title, 'Titlu', class: 'fcard-label' %>
          <div class="fcard-input-wrap">
            <i class="fa fa-header fcard-input-icon"></i>
            <%= f.text_field :title, class: 'fcard-input' %>
          </div>
        </div>

        <div class="fcard-field">
          <%= f.label :body, 'Conținut', class: 'fcard-label' %>
          <div class="fcard-input-wrap">
            <i class="fa fa-align-left fcard-input-icon fcard-input-icon-top"></i>
            <%= f.text_area :body, class: 'fcard-input fcard-textarea', rows: 8 %>
          </div>
        </div>

        <div class="fcard-field">
          <label class="fcard-label">Etichete</label>
          <div class="tag-input-box" id="tagInputBox">
            <div class="tag-input-pills" id="tagPills"></div>
            <input type="text" id="tagInput" class="tag-input-field" placeholder="Adaugă etichetă…" autocomplete="off">
            <ul class="tag-suggestions" id="postTagSuggestions"></ul>
          </div>
          <div id="tagHiddenFields"></div>
          <p class="tag-input-hint">Alege din sugestii sau scrie un tag nou și apasă <kbd>Enter</kbd></p>
        </div>
        <script>window.POST_EXISTING_TAGS = <%= @post.tags.map { |t| { id: t.id, name: t.name } }.to_json.html_safe %>;</script>

        <div class="fcard-field">
          <label class="fcard-label">Imagini</label>
          <% if @post.images.attached? %>
            <div class="image-existing-list">
              <% @post.images.each do |img| %>
                <div class="image-existing-item">
                  <%= image_tag img, class: 'image-existing-thumb' %>
                  <label class="image-remove-label">
                    <%= check_box_tag 'post[remove_image_ids][]', img.id %>
                    Șterge
                  </label>
                </div>
              <% end %>
            </div>
          <% end %>
          <div class="image-upload-area" id="imageUploadArea">
            <input type="file" id="imageInput" name="post[images][]" multiple accept="image/*" class="image-upload-input">
            <label for="imageInput" class="image-upload-label">
              <i class="fa fa-cloud-upload"></i>
              <span>Adaugă imagini noi sau <u>apasă pentru a selecta</u></span>
              <small>PNG, JPG, GIF — maxim 5 fișiere</small>
            </label>
            <div class="image-preview-list" id="imagePreviewList"></div>
          </div>
        </div>

        <div class="fcard-actions fcard-actions-inline">
          <%= f.submit 'Salvează', class: 'fcard-btn' %>
          <%= link_to 'Anulează', feed_path, class: 'fcard-cancel' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
