<div class="form-page">
  <h2><i class="fa fa-pencil"></i> Edit Post</h2>

  <%= form_with model: @post, url: post_path(@post), method: :patch, local: true, class: 'post-form' do |f| %>
    <% if @post.errors.any? %>
      <div class="flash-alert">
        <% @post.errors.full_messages.each do |msg| %>
          <div><%= msg %></div>
        <% end %>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :title, 'Title' %>
      <%= f.text_field :title, class: 'form-control' %>
    </div>

    <div class="form-group">
      <%= f.label :body, 'Content' %>
      <%= f.text_area :body, class: 'form-control', rows: 8 %>
    </div>

    <div class="form-actions">
      <%= f.submit 'Save', class: 'btn btn-primary' %>
      <%= link_to 'Cancel', feed_path, class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>
