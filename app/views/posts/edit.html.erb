<div class="fcard-page">
  <div class="fcard fcard-wide">
    <div class="fcard-header">
      <i class="fa fa-pencil fcard-icon"></i>
      <h1 class="fcard-title">Editează postarea</h1>
    </div>

    <div class="fcard-body">
      <%= form_with model: @post, url: post_path(@post), method: :patch, local: true do |f| %>
        <% if @post.errors.any? %>
          <div class="fcard-errors">
            <i class="fa fa-exclamation-circle"></i>
            <ul>
              <% @post.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="fcard-field">
          <%= f.label :title, 'Titlu', class: 'fcard-label' %>
          <div class="fcard-input-wrap">
            <i class="fa fa-header fcard-input-icon"></i>
            <%= f.text_field :title, class: 'fcard-input' %>
          </div>
        </div>

        <div class="fcard-field">
          <%= f.label :body, 'Conținut', class: 'fcard-label' %>
          <div class="fcard-input-wrap">
            <i class="fa fa-align-left fcard-input-icon fcard-input-icon-top"></i>
            <%= f.text_area :body, class: 'fcard-input fcard-textarea', rows: 8 %>
          </div>
        </div>

        <div class="fcard-field">
          <%= f.label :tag_ids, 'Etichete', class: 'fcard-label' %>
          <div class="tag-checkboxes">
            <% @all_tags.each do |tag| %>
              <label class="tag-checkbox-label">
                <%= f.check_box :tag_ids, { multiple: true, checked: @post.tags.include?(tag) }, tag.id, false %>
                #<%= tag.name %>
              </label>
            <% end %>
          </div>
        </div>

        <div class="fcard-actions fcard-actions-inline">
          <%= f.submit 'Salvează', class: 'fcard-btn' %>
          <%= link_to 'Anulează', feed_path, class: 'fcard-cancel' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
