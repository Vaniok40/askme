<div class="post-card" data-post-id="<%= post.id %>">
  <div class="post-card-author">
    <div class="post-avatar" style="background:<%= avatar_color(post.user) %>">
      <%= post.user.name[0].upcase %>
    </div>
    <div class="post-author-info">
      <% if current_user %>
        <%= link_to post.user.name, user_path(post.user), class: 'post-author-name' %>
        <%= link_to "@#{post.user.username}", user_path(post.user), class: 'post-author-username' %>
      <% else %>
        <span class="post-author-name"><%= post.user.name %></span>
        <span class="post-author-username">@<%= post.user.username %></span>
      <% end %>
    </div>
    <span class="post-date"><%= ro_date(post.created_at) %></span>
  </div>

  <h3 class="post-card-title"><%= post.title %></h3>
  <p class="post-card-body"><%= truncate(post.body, length: 180) %></p>
  <% if post.images.attached? %>
    <div class="post-card-images">
      <% post.images.first(3).each do |img| %>
        <%= image_tag img, class: 'post-card-image' %>
      <% end %>
      <% if post.images.count > 3 %>
        <div class="post-card-images-more">+<%= post.images.count - 3 %></div>
      <% end %>
    </div>
  <% end %>

  <% if post.tags.any? %>
    <div class="post-card-tags">
      <% post.tags.each do |tag| %>
        <span class="post-tag">#<%= tag.name %></span>
      <% end %>
    </div>
  <% end %>

  <div class="post-card-meta">
    <span><i class="fa fa-eye"></i> <%= post.views_count %></span>
    <% liked = current_user && post.likes.any? { |l| l.user_id == current_user.id } %>
    <span class="<%= 'post-card-liked' if liked %>"><i class="fa <%= liked ? 'fa-heart' : 'fa-heart-o' %>"></i> <%= post.likes.size %></span>
    <span><i class="fa fa-comment-o"></i> <%= post.comments.size %></span>
    <% if current_user %>
      <button class="post-forward-btn" onclick="openForwardModal(<%= post.id %>); event.stopPropagation();" title="Trimite în chat">
        <i class="fa fa-share"></i>
      </button>
    <% end %>
    <% if admin_user? && current_user != post.user %>
      <%= button_to post_path(post), method: :delete, class: 'post-admin-delete-btn', title: 'Șterge postarea', onclick: 'event.stopPropagation(); return confirm("Ștergi această postare?")' do %>
        <i class="fa fa-trash"></i>
      <% end %>
    <% end %>
  </div>
</div>
