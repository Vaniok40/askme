<div class="post-card" data-post-id="<%= post.id %>">
  <div class="post-card-author">
    <div class="post-avatar" style="background:<%= post.user.color %>">
      <%= post.user.name[0].upcase %>
    </div>
    <div class="post-author-info">
      <span class="post-author-name"><%= post.user.name %></span>
      <span class="post-author-username">@<%= post.user.username %></span>
    </div>
    <span class="post-date"><%= post.created_at.strftime('%b %d') %></span>
  </div>

  <h3 class="post-card-title"><%= post.title %></h3>
  <p class="post-card-body"><%= truncate(post.body, length: 180) %></p>

  <% if post.tags.any? %>
    <div class="post-card-tags">
      <% post.tags.each do |tag| %>
        <span class="post-tag">#<%= tag.name %></span>
      <% end %>
    </div>
  <% end %>

  <div class="post-card-meta">
    <span><i class="fa fa-eye"></i> <%= post.views_count %></span>
    <span><i class="fa fa-heart-o"></i> <%= post.likes.size %></span>
    <span><i class="fa fa-comment-o"></i> <%= post.comments.size %></span>
  </div>
</div>
