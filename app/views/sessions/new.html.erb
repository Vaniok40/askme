<div class="auth-page">
  <div class="auth-card">
    <div class="auth-card-header">
      <i class="fa fa-sign-in auth-icon"></i>
      <h1 class="auth-title">Autentificare</h1>
      <p class="auth-subtitle">Bine ai revenit!</p>
    </div>

    <div class="auth-card-body">
      <%= form_tag sessions_path do %>
        <div class="auth-field">
          <%= label_tag :email, 'Email', class: 'auth-label' %>
          <div class="auth-input-wrap">
            <i class="fa fa-envelope auth-input-icon"></i>
            <%= text_field_tag :email, params[:email], class: 'auth-input', placeholder: 'adresa@exemplu.com' %>
          </div>
        </div>

        <div class="auth-field">
          <%= label_tag :password, 'Parolă', class: 'auth-label' %>
          <div class="auth-input-wrap">
            <i class="fa fa-lock auth-input-icon"></i>
            <%= password_field_tag :password, '', class: 'auth-input', placeholder: '••••••••' %>
          </div>
        </div>

        <div class="auth-actions">
          <%= submit_tag "Autentificare", class: 'auth-btn' %>
        </div>
      <% end %>
    </div>

    <div class="auth-card-footer">
      Nu ai cont?
      <%= link_to 'Înregistrează-te', sign_up_path, class: 'auth-link' %>
    </div>
  </div>
</div>
